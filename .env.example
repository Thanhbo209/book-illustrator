# SQLite connection used by Prisma. The file is created automatically by
# `prisma migrate deploy` / `prisma migrate dev` — no server to install.
DATABASE_URL="file:./dev.db"

# Server-only secret used to sign the session cookie (HMAC). Any random
# string works for local use, e.g.: openssl rand -hex 32
SESSION_SECRET="change-me-to-a-random-string"

# Gemini API key. Get one at https://aistudio.google.com/apikey
# Server-side only — never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=""

# Current Gemini model IDs (see DECISIONS.md for why these were chosen).
GEMINI_TEXT_MODEL="gemini-3.6-flash"
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
